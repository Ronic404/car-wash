{
  "name": "car-wash",
  "version": "1.0.0",
  "description": "Приложение для автомойки с Telegram ботом и веб-панелью администратора",
  "private": true,
  "workspaces": [
    "api",
    "telegram-bot",
    "admin-web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=telegram-bot\" \"npm run dev --workspace=admin-web\"",
    "build": "npm run build --workspaces",
    "install:all": "npm install && npm install --workspaces",
    "type-check": "npm run type-check --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

